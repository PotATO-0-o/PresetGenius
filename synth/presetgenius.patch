+namespace {
+  const char* kAiServerHost = "http://127.0.0.1:8901";
+  constexpr int kAiTimeoutMs = 120000;
+}
+
+void SynthPresetSelector::aiPresetFromText(bool optimize) {
+  String hint = optimize
+      ? "Describe the sound. Optimized mode is slower but closer to the prompt."
+      : "Describe the sound, e.g. warm analog sub bass";
+  AlertWindow prompt_window("PresetGenius", hint, AlertWindow::NoIcon);
+  prompt_window.addTextEditor("prompt", "", "");
+  prompt_window.addButton("Generate", 1, KeyPress(KeyPress::returnKey));
+  prompt_window.addButton("Cancel", 0, KeyPress(KeyPress::escapeKey));
+  if (prompt_window.runModalLoop() != 1)
+    return;
+
+  String prompt = prompt_window.getTextEditorContents("prompt").trim();
+  if (prompt.isEmpty())
+    return;
+
+  json body;
+  body["prompt"] = prompt.toStdString();
+  body["optimize"] = optimize;
+  body["iters"] = 8;
+
+  URL url = URL(String(kAiServerHost) + "/text2preset").withPOSTData(body.dump());
+  startAiRequest(url, "application/json");
+}
+
+void SynthPresetSelector::aiPresetFromAudio() {
+  FileChooser open_box("Select Audio To Match", File(),
+                       "*.wav;*.mp3;*.flac;*.ogg;*.aif;*.aiff");
+  if (!open_box.browseForFileToOpen())
+    return;
+
+  File audio_file = open_box.getResult();
+  if (!audio_file.exists())
+    return;
+
+  URL url = URL(String(kAiServerHost) + "/audio2preset")
+                .withFileToUpload("file", audio_file, "audio/wav");
+  startAiRequest(url, "");
+}
+
+void SynthPresetSelector::startAiRequest(URL url, String content_type) {
+  selector_->setText("Generating AI preset...");
+
+  Component::SafePointer<SynthPresetSelector> safe_this(this);
+  std::thread([safe_this, url, content_type]() {
+    String headers;
+    if (content_type.isNotEmpty())
+      headers = "Content-Type: " + content_type + "\r\n";
+
+    int status_code = 0;
+    std::unique_ptr<InputStream> stream =
+        url.createInputStream(true, nullptr, nullptr, headers, kAiTimeoutMs, nullptr, &status_code);
+    String response = stream ? stream->readEntireStreamAsString() : String();
+
+    MessageManager::callAsync([safe_this, response, status_code]() mutable {
+      if (safe_this.getComponent() != nullptr)
+        safe_this->finishAiRequest(response, status_code);
+    });
+  }).detach();
+}
+
+void SynthPresetSelector::finishAiRequest(String response, int status_code) {
+  resetText();
+  if (status_code != 200 || response.isEmpty()) {
+    String details = response.substring(0, 240);
+    AlertWindow::showNativeDialogBox(
+        "PresetGenius",
+        "AI server did not answer (HTTP " + String(status_code) + ").\n"
+        "Start Start-PresetGenius.bat first, then try again.\n" + details,
+        false);
+    return;
+  }
+
+  try {
+    json parsed = json::parse(response.toStdString());
+    json preset = parsed["preset"];
+    String display_name = "AI Preset";
+    if (parsed.count("name") && parsed["name"].is_string())
+      display_name = parsed["name"].get<std::string>();
+    display_name = File::createLegalFileName(display_name);
+    if (display_name.isEmpty())
+      display_name = "AI Preset";
+
+    File temp_file = File::getSpecialLocation(File::tempDirectory)
+                         .getChildFile(display_name + ".vital");
+    temp_file.replaceWithText(preset.dump());
+
+    SynthGuiInterface* parent = findParentComponentOfClass<SynthGuiInterface>();
+    std::string error;
+    if (!parent->getSynth()->loadFromFile(temp_file, error)) {
+      AlertWindow::showNativeDialogBox("PresetGenius",
+                                       "Error loading generated preset. " + error, false);
+    }
+    else {
+      parent->getSynth()->setPresetName(display_name);
+      parent->externalPresetLoaded(temp_file);
+      resetText();
+    }
+  }
+  catch (const std::exception& e) {
+    AlertWindow::showNativeDialogBox("PresetGenius",
+                                     std::string("Bad server response: ") + e.what(), false);
+  }
+}
